#!/usr/bin/env sh

# Git hooks always start at the root of the Git repository.
# Check if this commit actually touches any files in frontend/carebase-frontend:

if git diff --cached --name-only | grep -q '^frontend/carebase-frontend/'; then
  echo "Changes detected in frontend/carebase-frontend. Running checks..."
  export CI=true
  cd frontend/carebase-frontend || exit 1

  # 1. Format staged files with Prettier
  npx lint-staged || exit 1

  # 2. Type-check the Angular application
  npm run typecheck || exit 1

  # 3. Run unit tests
  npm run test:run || exit 1
fi